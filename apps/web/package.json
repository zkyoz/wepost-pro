{
  "name": "@wepost/web",
  "version": "0.1.0-rc.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint app e2e server nuxt.config.ts playwright.config.ts playwright.public.config.ts vitest.config.ts && eslint --no-ignore tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "generate": "nuxt generate",
    "i18n:check": "vitest run tests/i18n/messages.spec.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "posthog-js": "^1.417.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
