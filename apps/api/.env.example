# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=redis
SESSION_COOKIE_NAME=wepost_session_dev
SESSION_COOKIE_DOMAIN=
SESSION_AGE=8h

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wepost
DB_PASSWORD=wepost
DB_DATABASE=wepost

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_DB=0
REDIS_LIMITER_DB=1
REDIS_QUEUE_DB=2
REDIS_KEY_PREFIX=wepost:development

# Collaboration and asynchronous e-mails
EMAIL_QUEUE_DRIVER=redis
EMAIL_QUEUE_NAME=wepost-jobs
COMMENT_EDIT_WINDOW_MINUTES=15
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_HEARTBEAT_TTL_SECONDS=300
UPTIME_KUMA_WORKER_PUSH_URL=

# Facebook OAuth and publishing. Replace the TODO version from the Meta app dashboard.
SOCIAL_TOKEN_ENCRYPTION_KEY=
FACEBOOK_API_DRIVER=mock
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=TODO_SET_FROM_META_APP_DASHBOARD
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/social/facebook/oauth/callback
FACEBOOK_OAUTH_SUCCESS_URL=http://localhost:3000/settings/facebook
INSTAGRAM_API_DRIVER=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=TODO_SET_FROM_META_APP_DASHBOARD
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/social/instagram/oauth/callback
INSTAGRAM_OAUTH_SUCCESS_URL=http://localhost:3000/settings/instagram
LINKEDIN_API_DRIVER=mock
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_API_VERSION=TODO_SET_FROM_LINKEDIN_DEVELOPER_PORTAL
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/social/linkedin/oauth/callback
LINKEDIN_OAUTH_SUCCESS_URL=http://localhost:3000/settings/linkedin
PINTEREST_API_DRIVER=mock
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/social/pinterest/oauth/callback
PINTEREST_OAUTH_SUCCESS_URL=http://localhost:3000/settings/pinterest
TIKTOK_API_DRIVER=mock
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/social/tiktok/oauth/callback
TIKTOK_OAUTH_SUCCESS_URL=http://localhost:3000/settings/tiktok

# Security
LIMITER_STORE=redis
AUTH_LOGIN_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:3000

# Private media storage. Use "r2" only once every R2 secret exists.
MEDIA_STORAGE_DRIVER=local
MEDIA_MAX_BYTES=20971520
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_ABANDONED_UPLOAD_MINUTES=60
MEDIA_AGENCY_QUOTA_BYTES=10737418240
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENVIRONMENT_PREFIX=development

# PostgreSQL backups. Generate a new 32-byte base64 encryption key per environment.
# Use a private bucket and credentials distinct from the media application credentials.
BACKUP_ENCRYPTION_KEY=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_PREFIX=development/database
UPTIME_KUMA_BACKUP_PUSH_URL=

# Restore drills only. The database name must end with _restore, _drill or _test.
RESTORE_DB_HOST=127.0.0.1
RESTORE_DB_PORT=5432
RESTORE_DB_USER=wepost
RESTORE_DB_PASSWORD=
RESTORE_DB_DATABASE=wepost_restore_test
